# ====== ForexMind environment ======
# Copy this file to ".env" and fill in your keys, then run: npm install && npm start
# NEVER commit your real .env file or share these keys publicly.

# --- Market data: Twelve Data (free tier covers XAU/USD + intraday) ---
# Get a free key at: https://twelvedata.com/  (Dashboard -> API Keys)
TWELVE_DATA_KEY=

# --- AI reasoning: Google Gemini ---
# Get a FREE key at: https://aistudio.google.com/app/apikey  (click "Create API key")
GEMINI_API_KEY=
# Optional: override the model (defaults to a fast, capable Gemini model)
GEMINI_MODEL=gemini-1.5-flash

# --- Gmail notifications (optional) ---
# Sends trade-signal alerts & daily briefings to your inbox.
# 1) Use a Gmail account as the SENDER.
# 2) Enable 2-Step Verification, then create an "App Password":
#    https://myaccount.google.com/apppasswords  (pick "Mail")
# 3) Paste the 16-char app password below (NOT your normal password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where alerts are delivered (defaults to GMAIL_USER if left blank):
ALERT_TO=cletusmawa@gmail.com

# --- Server ---
PORT=3000
